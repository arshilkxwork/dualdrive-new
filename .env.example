# Copy to .env at the project root. Both audit/run.sh and keyholder/ read it.

# The upstream demo-service repo, owned by the keyholder bot account.
UPSTREAM_REPO_URL=https://github.com/OWNER/demo-service.git
GITHUB_REPOSITORY=OWNER/demo-service

# Fine-grained token of the keyholder bot account, for that one repo only:
# Pull requests read/write, Contents read/write, Checks read.
GITHUB_TOKEN=

# Switch's agent bridge (not the Gateway URL). GET <url>/health answers 200.
SWITCH_BRIDGE_URL=http://localhost:8000

# Only for `npm run register`, once.
SWITCH_REGISTRATION_TOKEN=

# Printed by `npm run register`.
KEYHOLDER_AGENT_ID=
KEYHOLDER_API_KEY=

# The room the template created.
DUALDRIVE_ROOM_ID=

# Who keyholder listens to. Participant ids (@switch-…:…) are exact; plain
# names match the sender's display name. keyholder logs both for every
# approval it sees, so start with names and switch to ids.
REVIEWER_SENDERS=alice,bob
AUDITOR_SENDERS=auditor

# @keyholder's handle as it appears in the room.
KEYHOLDER_HANDLE=keyholder
