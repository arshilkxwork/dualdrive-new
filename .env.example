# There are two .env files, in two copies of this repo (README, setup step 4):
#
# - Yours, the one the agents run from. audit/run.sh reads it, and the agents
#   can read it too, so it holds only the "audit" settings below.
# - keyholder's, in its own copy under its own macOS user, readable only by
#   that user (chmod 600). It holds the "keyholder" settings below.
#
# audit/run.sh refuses to run if it finds keyholder's secrets in its .env.

# ---- Both ----

# The upstream demo-service repo, owned by the keyholder bot account.
UPSTREAM_REPO_URL=https://github.com/OWNER/demo-service.git
GITHUB_REPOSITORY=OWNER/demo-service

# GitHub Enterprise Server's web address, which audit/run.sh clones other
# repos from and sends AUDIT_GITHUB_TOKEN to. Unset means github.com. When
# it's set, GITHUB_API_URL defaults to its /api/v3 for both audit/run.sh and
# keyholder.
# GITHUB_SERVER_URL=https://github.example.com

# GitHub's API, for GitHub Enterprise (https://HOST/api/v3). Unset means
# api.github.com. The sandbox (docker compose up) and scripts/audit-e2e.sh
# point it at stand-ins.
# GITHUB_API_URL=

# ---- audit ----

# Optional while every repo is public, like demo-service: then it only raises
# GitHub's rate limit. Required for a private repo, for the clone and the
# files API both: a fine-grained token with Contents: read and Pull
# requests: read on each repo audit/run.sh audits. Never the bot account's
# token.
# AUDIT_GITHUB_TOKEN=

# Optional, for networks that reach registries only through a mirror: the
# osv-scanner image audit/run.sh runs for non-npm lockfiles, and the npm
# registry npm audit asks. Unset means ghcr.io and registry.npmjs.org.
# OSV_IMAGE=ghcr.io/google/osv-scanner:v2.2.4
# NPM_AUDIT_REGISTRY=https://registry.npmjs.org/

# Optional: how osv-scanner looks vulnerabilities up. online (the default)
# asks osv.dev; offline reads databases saved in OSV_DB_DIR, with no network,
# for machines that can't reach osv.dev (README says how to fill it); off
# skips it, and the report says it was skipped.
# OSV_MODE=online
# OSV_DB_DIR=/Users/you/osv-db

# Optional: seconds the pull request's tests, and the dependency scan, may
# run before audit/run.sh stops them. Unset means 600 and 300.
# AUDIT_TEST_TIMEOUT=600
# AUDIT_SCAN_TIMEOUT=300

# ---- keyholder ----

# Fine-grained token of the keyholder bot account, for that one repo only:
# Pull requests read/write, Contents read/write, Checks read.
GITHUB_TOKEN=

# More repos this one keyholder merges into, comma-separated owner/repo.
# Reviewers name them as "@keyholder approve owner/repo#4"; a plain "#4" is
# always GITHUB_REPOSITORY. GITHUB_TOKEN must then cover each of them.
# EXTRA_REPOSITORIES=OWNER/frontend,OWNER/infra

# Rules for one repo where they differ from SENSITIVE_PATHS, BASE_BRANCH and
# REQUIRED_CHECKS below: JSON, keyed by owner/repo, in single quotes. Every
# extra repo needs its own sensitive_paths, and keyholder won't start
# without them: SENSITIVE_PATHS only describes GITHUB_REPOSITORY.
# REPO_SETTINGS='{"OWNER/frontend": {"base_branch": "master", "required_checks": ["build"], "sensitive_paths": ["src/auth/", "package.json"], "merge_method": "squash"}}'

# Switch's agent bridge (not the Gateway URL). GET <url>/health answers 200.
SWITCH_BRIDGE_URL=http://localhost:8000

# Only for `npm run register`, once.
SWITCH_REGISTRATION_TOKEN=

# Printed by `npm run register`.
KEYHOLDER_AGENT_ID=
KEYHOLDER_API_KEY=

# The room the template created.
DUALDRIVE_ROOM_ID=

# Who keyholder listens to. Participant ids (@switch-…:…) are exact; plain
# names match the sender's display name. keyholder logs both for every
# approval it sees, so start with names and switch to ids.
REVIEWER_SENDERS=alice,bob
AUDITOR_SENDERS=auditor

# @keyholder's handle as it appears in the room.
KEYHOLDER_HANDLE=keyholder

# Where keyholder keeps the approvals it has counted, so they survive a
# restart. Unset means keyholder/.state.json in its own copy.
# KEYHOLDER_STATE_FILE=/Users/dualdrive-keyholder/dualdrive/keyholder/.state.json

# Paths in the upstream repo that need two approvals whatever the audit
# says, comma-separated. Each covers that path and anything under it, so
# src/auth and src/auth/ both cover the folder. Leave it unset
# for demo-service's defaults. .github/ and .env files always count.
# SENSITIVE_PATHS=src/auth.js,src/auth/,package.json,package-lock.json

# false for a repo with no CI at all, where no check run or status will ever
# appear: keyholder then takes none as a pass, after one more look. Required
# checks are still waited for, so give such a repo "required_checks": [] in
# REPO_SETTINGS too. REPO_SETTINGS can set require_ci per repo. Unset means
# true.
# REQUIRE_CI=true

# How GitHub merges: merge, squash or rebase, whichever the repo allows.
# Unset means merge. With rebase there's no merge commit, so the
# Approved-by trailers are only in the ledger. REPO_SETTINGS can set
# merge_method per repo.
# MERGE_METHOD=merge

# The only branch keyholder merges into. Unset means main.
# BASE_BRANCH=main

# Check runs that must exist and pass before a merge, comma-separated, by
# the name GitHub shows. demo-service's workflow job is "test". Unset means
# keyholder waits for whatever check runs exist to pass.
REQUIRED_CHECKS=test

# How long a merge waits for check runs to finish, in milliseconds. Unset
# means 120000 (two minutes): a cold GitHub Actions runner can take a minute
# just to start. When it runs out the approvals stay and a reviewer approves
# again once CI is green.
# CI_TIMEOUT_MS=120000
